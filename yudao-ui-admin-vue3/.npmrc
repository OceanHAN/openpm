## 由 DSH 于 2026-09-11 添加
## 原因：仓库自带的 pnpm-lock.yaml 是在淘宝镜像(registry.npmmirror.com)下生成的，
##      而本机全局 ~/.npmrc 指向 registry.npmjs.org，导致 pnpm 11 的供应链校验报
##      ERR_PNPM_TARBALL_URL_MISMATCH（159 条不一致）。
##      统一到淘宝镜像后校验通过，但本机出口带宽较小（实测 40 KiB/s 左右），
##      默认超时会让大包下载中断，故放宽超时与重试参数。
registry=https://registry.npmmirror.com

# 下载超时放宽到 10 分钟（默认 60s 太小）
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000

# 降低并发，避免小带宽下互相抢占导致集体超时
network-concurrency=4
child-concurrency=2
